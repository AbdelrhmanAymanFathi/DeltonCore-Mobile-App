# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env إلى المستودع.

# عنوان مسارات الموبايل في الباك إند.
# لازم https في أي شيء غير التطوير المحلي.
EXPO_PUBLIC_API_BASE=https://hr.example.com/api/mobile

# 1 = تشغيل الخادم الوهمي في src/api/mock.ts، فيعمل التطبيق كاملًا بدون باك إند.
# أطفئه (0) بمجرد أن تجهز مسارات /api/mobile/.
# الخادم الوهمي يرفض العمل في نسخة الإنتاج، فلا يمكن أن يُشحن بالخطأ.
EXPO_PUBLIC_USE_MOCK=1
