{
  "expo": {
    "name": "دلتون للموارد بشرية",
    "slug": "delton-core-supervisor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "supportsRTL": true,
    "icon": "./assets/appicon.png",
    "scheme": "deltoncore",
    "splash": {
      "image": "./assets/loadingicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F0",
      "imageWidth": 240
    },
    "androidStatusBar": {
      "backgroundColor": "#0D1522",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.deltoncore.supervisor",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/appicon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نحدد موقعك وقت تسجيل الحضور للتأكد أنك داخل نطاق الموقع."
        }
      ],
      "expo-secure-store",
      "expo-splash-screen",
      "expo-system-ui"
    ],
    "extra": {
      "notes": {
        "rtl": "الاتجاه يُضبط وقت التشغيل من اللغة المختارة (جذر الواجهة في App.tsx عبر خاصية direction)، فالتبديل بين العربية والإنجليزية لا يحتاج إعادة تشغيل.",
        "backgroundLocation": "ACCESS_BACKGROUND_LOCATION محجوب عمدًا: التطبيق لا يحتاج تتبعًا في الخلفية، وطلبه يثير قلق المستخدمين ويستدعي مراجعة إضافية لو نُشر على المتاجر لاحقًا."
      }
    }
  }
}
